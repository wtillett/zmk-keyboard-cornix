#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// quick tapping for shift

#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70
#define BASE 0
#define WIN 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define NAVI   5
#define NUM    6
#define DEBUG  7

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
            hold-while-undecided;
        };

        hm_gui_l: homerow_mods_gui_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
            hold-while-undecided;
        };

        hm_gui_r: homerow_mods_gui_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        // Positional Homerow mods for shift
        // Use faster tapping term and disable some features that may
        // cause false negatives.

        hm_shift_l: hm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            //flavor = "balanced";

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
            hold-while-undecided;
        };

        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;

            // for quick tapping; shift+~

            hold-trigger-on-release;
            hold-while-undecided;
        };

        /*
         * Non-Positional Homerow Mods
         * Used for &mm_grescm_gui behavior on left hand.
         *
         * Usage: &hm LSHFT T
         * Tap: T
         * Tap-Tap-Hold: Repeat T
         * Hold: LSHIFT
         */

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        td_lprn_lcbr: tap_dance_left_prn_cbr {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LPAR>, <&kp LBRC>;
        };

        td_rprn_rcbr: tap_dance_right_prn_cbr {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RPAR>, <&kp RBRC>;
        };

        td_comm_scln: tap_dance_comm_scln {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp COMMA>, <&kp SEMICOLON>;
        };

        td_slsh_scln: tap_dance_slsh_scln {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SLASH>, <&kp SEMICOLON>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_caps_word {
            key-positions = <28 33>;
            bindings = <&caps_word>;
        };

        combo_caps_lock {
            key-positions = <29 32>;
            bindings = <&kp CAPSLOCK>;
        };

        combo_esc {
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_copy {
            key-positions = <26 27>;
            bindings = <&kp LC(C)>;
        };

        combo_cut {
            key-positions = <26 28>;
            bindings = <&kp LC(X)>;
        };

        combo_paste {
            key-positions = <27 28>;
            bindings = <&kp LC(V)>;
        };

        combo_game {
            key-positions = <0 11>;
            bindings = <&tog 6>;
        };

        combo_semicolon {
            key-positions = <34 35>;
            bindings = <&kp SEMICOLON>;
        };

        combo_quote {
            key-positions = <33 34>;
            bindings = <&kp DOUBLE_QUOTES>;
        };

        combo_canary {
            key-positions = <30 31>;
            bindings = <&tog 1>;
        };

        combo_num {
            key-positions = <33 34 35>;
            bindings = <&tog 3>;
        };

        combo_debug {
            bindings = <&mo 7>;
            key-positions = <40 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE      &kp Q             &kp W  &kp E                     &kp R          &kp T                               &kp Y      &kp U          &kp I                      &kp O      &kp P                 &kp BACKSPACE
&kp BACKSPACE  &kp A             &kp S  &hm_shift_l LEFT_SHIFT D  &lt 3 F        &kp G                               &kp H      &lt 5 J        &hm_shift_r RIGHT_SHIFT K  &kp L      &hm_r RIGHT_ALT SEMI  &kp SQT
&td_lprn_lcbr  &hm_gui_l LGUI Z  &kp X  &kp C                     &hm_l LCTRL V  &kp B         &kp K_MUTE  &mkp MB3  &kp N      &hm_r RCTRL M  &td_comm_scln              &lt 5 DOT  &hm_gui_r RGUI SLASH  &td_rprn_rcbr
&none          &none             &none  &kp BACKSPACE             &lt 4 TAB      &kp C_REPEAT                        &kp SPACE  &lt 4 ENTER    &lt 2 DELETE               &none      &none                 &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        canary_layer {
            display-name = "Canary";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE      &kp W             &kp L  &kp Y                     &kp P          &kp B                         &kp Z      &kp F          &kp O                      &kp U        &kp SQT             &kp BACKSLASH
&kp BACKSPACE  &kp C             &kp R  &hm_shift_l LEFT_SHIFT S  &lt 3 T        &kp G                         &kp M      &lt 5 N        &hm_shift_r RIGHT_SHIFT E  &kp I        &hm_r RIGHT_ALT A   &kp SEMICOLON
&td_lprn_lcbr  &hm_gui_l LGUI Q  &kp J  &kp V                     &hm_l LCTRL D  &kp K         &trans  &trans  &kp X      &hm_r RCTRL H  &td_slsh_scln              &lt 5 COMMA  &hm_gui_r RGUI DOT  &td_rprn_rcbr
&none          &none             &none  &kp BACKSPACE             &lt 4 TAB      &kp C_REPEAT                  &kp SPACE  &lt 4 ENTER    &lt 2 DELETE               &none        &none               &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Nav_layer {
            display-name = "Nav";

            // TODO: Some binds are waiting for shifted keycode support.
            // -------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&none  &kp F1  &kp F2        &kp F3      &kp F4     &kp F5                   &kp HOME  &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &none       &kp PRINTSCREEN
&none  &kp F6  &kp LEFT_ALT  &kp LSHIFT  &kp LCTRL  &kp F7                   &kp END   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp INSERT  &none
&none  &kp F8  &kp F9        &kp F10     &kp F11    &kp F12  &trans  &trans  &none     &none           &none           &none            &none       &none
&none  &none   &none         &none       &trans     &trans                   &none     &trans          &none           &none            &none       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Num_layer {
            display-name = "Num";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans  &none  &none  &none  &none   &none                      &kp PLUS   &kp N7  &kp N8   &kp N9  &kp ASTRK  &kp BSPC
&trans  &none  &none  &none  &none   &none                      &kp COMMA  &kp N4  &kp N5   &kp N6  &kp SLASH  &none
&trans  &none  &none  &none  &none   &none      &trans  &trans  &kp MINUS  &kp N1  &kp N2   &kp N3  &kp SLASH  &kp ENTER
&none   &none  &none  &none  &trans  &kp ENTER                  &kp TAB    &kp N0  &kp DOT  &none   &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Symbol_layer {
            display-name = "Symbol";

            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | moDEBUG| RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&kp ESC  &kp GRAVE  &kp ASTRK  &kp LT    &kp GT     &kp UNDER                    &kp DOLLAR  &kp LBRC              &kp RBRC               &kp CARET  &none     &none
&none    &kp EXCL   &kp DQT    &kp FSLH  &kp MINUS  &kp PLUS                     &kp HASH    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL  &kp AMPS  &none
&none    &kp TILDE  &kp PLUS   &kp LBKT  &kp RBKT   &kp PERCENT  &trans  &trans  &kp AT      &kp FSLH              &kp PIPE               &kp BSLH   &none     &none
&none    &none      &none      &none     &none      &none                        &none       &none                 &none                  &none      &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Windows_layer {
            display-name = "Windows";
            bindings = <
&none  &kp F1  &kp F2  &kp F3     &kp F4   &kp F5                   &none  &none  &none        &none            &msc SCRL_DOWN  &none
&none  &kp F6  &none   &kp LG(D)  &none    &kp F7                   &none  &none  &kp LA(TAB)  &kp LA(LS(TAB))  &none           &none
&none  &kp F8  &kp F9  &kp F10    &kp F11  &kp F12  &trans  &trans  &none  &none  &none        &none            &none           &none
&none  &none   &none   &none      &none    &none                    &none  &none  &none        &none            &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Game_layer {
            display-name = "Game";
            bindings = <
&kp GRAVE  &kp Q  &kp W  &kp E     &kp R      &kp T                      &kp Y      &kp U      &kp I      &kp O    &kp P     &kp BSPC
&kp TAB    &kp A  &kp S  &kp D     &kp F      &kp G                      &kp H      &kp J      &kp K      &kp L    &kp SEMI  &kp APOS
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V      &kp B      &trans  &trans  &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp APOS
&none      &none  &none  &kp LALT  &kp LSHFT  &kp SPACE                  &kp SPACE  &kp ENTER  &kp RGUI   &none    &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Debug_layer {
            display-name = "Debug";

            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | BTCLR | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&kp A  &none  &none  &none       &none  &none                                &none        &none  &none  &none  &none  &none
&none  &none  &none  &none       &none  &sys_reset                           &sys_reset   &none  &none  &none  &none  &none
&none  &none  &none  &none       &none  &bootloader  &bt BT_CLR_ALL  &trans  &bootloader  &none  &none  &none  &none  &none
&none  &none  &none  &bt BT_NXT  &none  &none                                &none        &none  &none  &none  &none  &none
            >;
        };
    };
};
